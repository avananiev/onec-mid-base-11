&НаКлиенте
Перем ДЗ_ПоследняяСкидка; 

&НаКлиенте
Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
    
    Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
	//Если ДЗ_ПоследняяСкидка = Объект.ДЗ_СогласованнаяСкидка Тогда
	//    Возврат;
	//КонецЕсли;
	
	//ДЗ_ПоследняяСкидка = Объект.ДЗ_СогласованнаяСкидка;

    Описание = Новый ОписаниеОповещения("ДЗ_ПослеВопросаОПересчете", ЭтотОбъект);
    ПоказатьВопрос(Описание, "Пересчитать все строки с учетом новой скидки?", РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ПослеВопросаОПересчете(Результат, Параметры) Экспорт 	

    Если Результат = КодВозвратаДиалога.Да Тогда
        ДЗ_ВыполнитьПересчетТаблиц();
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_КомандаПересчитатьСкидку(Команда) 
	ДЗ_ВыполнитьПересчетТаблиц();
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ВыполнитьПересчетТаблиц()
    // Пересчет товаров
    Для Каждого Строка Из Объект.Товары Цикл
        РассчитатьСуммуСтроки(Строка);
    КонецЦикла;
	
	Для Каждого Строка Из Объект.Услуги Цикл
        РассчитатьСуммуСтроки(Строка);
    КонецЦикла;
КонецПроцедуры

// // Конец. Ананьев 
#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// // Начало. Ананьев 
	
	
	//@skip-check undefined-variable
	ДЗ_ДоработкаФорм.ДобавитьКонтактноеЛицоНаФорму(ЭтотОбъект);
	
	// Пытаемся найти группу, в которой лежит Контрагент
	ПолеКонтрагент = Элементы.Найти("Организация");

	Если ПолеКонтрагент <> Неопределено Тогда
	    ГруппаДляВставки = ПолеКонтрагент.Родитель;
	Иначе
	    // Если Контрагент не найден, добавляем просто на форму
	    ГруппаДляВставки = ЭтотОбъект;
	КонецЕсли;
	
	
	// Используем Вставить, чтобы группа появилась сразу после или перед Организацией
	ГруппаСкидки = Элементы.Добавить("ДЗ_ГруппаСкидки", Тип("ГруппаФормы"), ГруппаДляВставки);
	ГруппаСкидки.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаСкидки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда; // Поле и кнопка будут в ряд
	ГруппаСкидки.ОтображатьЗаголовок = Ложь; // Чтобы не загромождать интерфейс лишними надписями
	ГруппаСкидки.Отображение = ОтображениеОбычнойГруппы.Нет; // Без рамки
	
	
	// Добавляем поле скидки в шапку (в группу "ГруппаШапка")
	НовоеПоле = Элементы.Добавить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"), ГруппаСкидки);
	НовоеПоле.Вид = ВидПоляФормы.ПолеВвода;
	НовоеПоле.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	НовоеПоле.Заголовок = "Согласованная скидка";
	// Назначаем событие ПриИзменении
	НовоеПоле.УстановитьДействие("ПриИзменении", "ДЗ_СогласованнаяСкидкаПриИзменении");

	// Добавляем команду для кнопки
	КомандаПересчет = Команды.Добавить("ДЗ_КомандаПересчитатьСкидку");
	КомандаПересчет.Действие = "ДЗ_КомандаПересчитатьСкидку";
	КомандаПересчет.Заголовок = "Пересчитать скидку";

	// Добавляем саму кнопку на форму
	НоваяКнопка = Элементы.Добавить("ДЗ_КнопкаПересчета", Тип("КнопкаФормы"), ГруппаСкидки);
	НоваяКнопка.ИмяКоманды = "ДЗ_КомандаПересчитатьСкидку";
	// // Конец. Ананьев
	
КонецПроцедуры

